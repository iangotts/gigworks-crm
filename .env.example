# Copy to .env for local work. Never commit .env.
# A login that owns the database (superuser on Railway). The app switches to the crm_app role per request.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gigworks_crm
PORT=3000
# Browser origins allowed to make changing requests (comma separated).
ALLOWED_ORIGINS=http://localhost:5173
# true in production so the cookie is only sent over https.
COOKIE_SECURE=false
SESSION_DAYS=14
# Password hashing cost as a power of two. 16 is the default. Lower only for tests.
SCRYPT_LOG_N=16

# Signs the public subscribe form and the unsubscribe links. Required in production.
# Generate one with: openssl rand -hex 32
FORM_SECRET=
# The public address of this app, used in unsubscribe links in the export.
PUBLIC_URL=http://localhost:5173

# One-to-one email (phase 6). Without a key, local work keeps mail in memory and production refuses to send.
# EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_DAILY_CAP=200

# Google Calendar link (phase 7). Leave blank to turn the calendar link off.
# Redirect URI to register in Google Cloud: <PUBLIC_URL>/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Encrypts the stored Google sign-ins. Required in production.
CALENDAR_KEY=
